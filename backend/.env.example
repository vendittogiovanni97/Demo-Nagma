# Database
DATABASE_URL="postgresql://root:root123@localhost:5432/nagmadb_?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGINS=http://localhost:3000

# Debug (opzionale)
DEBUG_HTTP=false

# Password per modificare prenotazioni
# Genera con: openssl rand -base64 24
BOOKING_UPDATE_PASSWORD="REPLACE_ME_WITH_RANDOM_24_BYTES"

# Config init flags
INIT_CONFIG_FROM_DB=false
INIT_CONFIG_SEED=false
# Admin password for seed
ADMIN_PASSWORD="admin123"

# Super Admin password for seed
SUPER_ADMIN_PASSWORD="superadmin123"

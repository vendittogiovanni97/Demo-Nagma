# ─── Docker PostgreSQL (usato da docker-compose.yml / npm run db:up) ─────────
# SECURITY (Audit H4): nessuna credenziale di default commessa nel codice.
# Copiare questo file in .env e scegliere credenziali robuste:
#   cp .env.example .env
# Le stesse credenziali devono coincidere con DATABASE_URL in backend/.env.

POSTGRES_DB=nagmadb
POSTGRES_USER=nagma
POSTGRES_PASSWORD=cambia-questa-password
POSTGRES_PORT=5433

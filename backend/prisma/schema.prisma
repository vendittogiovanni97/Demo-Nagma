generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int         @id @default(autoincrement())
  name             String
  email            String      @unique
  password         String      // hashed password
  role             Role        @default(ADMIN)
  phone            String?
  color            String?     // colore calendario per il collaboratore
  deletedAt        DateTime?   // soft delete
  createdAt        DateTime    @default(now())
  whatsappLogs     WhatsAppMessageLog[]
  bookingHistories BookingHistory[]

  @@index([role])
  @@index([deletedAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  ARTIST
}

enum BookingAction {
  CREATED
  UPDATED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum StaffType {
  COLLABORATORE
  APPRENDISTA
}

model Staff {
  id        Int       @id @default(autoincrement())
  name      String
  type      StaffType
  color     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings  Booking[]
  shifts    Shift[]
  creamSales CreamSale[]

  @@index([type])
  @@index([createdAt])
}

model Shift {
  id            String    @id @default(cuid())
  date          DateTime
  startTime     String
  endTime       String
  breakDuration Int?
  notes         String?
  staffId       Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staff         Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([staffId, date])
}

model Customer {
  id            Int         @id @default(autoincrement())
  firstName     String
  lastName      String
  phone         String
  email         String?
  notes         String?
  deletedAt     DateTime?   // soft delete
  createdAt     DateTime    @default(now())
  bookings      Booking[]
  whatsappLogs  WhatsAppMessageLog[]

  @@index([phone])
  @@index([email])
  @@index([lastName, firstName])
  @@index([deletedAt, createdAt])
}

model Booking {
  id              Int             @id @default(autoincrement())
  customer        Customer        @relation(fields: [customerId], references: [id])
  customerId      Int
  artist          Staff?          @relation(fields: [artistId], references: [id])
  artistId        Int?
  date            DateTime
  duration        Int             @default(120)  // durata in minuti
  status          BookingStatus   @default(CONFIRMED)
  price           Float?
  deposit         Float?
  notes           String?
  outlookEventId  String?         // riservato per futura integrazione Outlook
  formData        Json?           // dati dinamici da form in base64
  history         BookingHistory[]
  attachments     Attachment[]
  deletedAt       DateTime?       // soft delete
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  whatsappLogs    WhatsAppMessageLog[]

  @@index([customerId, deletedAt])
  @@index([artistId, date])
  @@index([artistId, status, date])
  @@index([status, date])
  @@index([status])
  @@index([date])
}

model CreamTattoo {
  id          Int          @id @default(autoincrement())
  name        String       @default("Crema Protettiva Tattoo")
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sales       CreamSale[]
}

model CreamSale {
  id          Int          @id @default(autoincrement())
  cream       CreamTattoo @relation(fields: [creamId], references: [id])
  creamId     Int
  artist      Staff        @relation(fields: [artistId], references: [id])
  artistId    Int
  quantity    Int          @default(1)
  soldAt      DateTime     @default(now())

  @@index([creamId, soldAt])
  @@index([artistId, soldAt])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  RESCHEDULED
  COMPLETED
}

model BookingHistory {
  id          Int            @id @default(autoincrement())
  booking     Booking        @relation(fields: [bookingId], references: [id])
  bookingId   Int
  action      BookingAction
  oldDate     DateTime?
  newDate     DateTime?
  changedById Int?
  changedBy   User?         @relation(fields: [changedById], references: [id])
  changedAt   DateTime       @default(now())

  @@index([bookingId, changedAt])
  @@index([changedById])
}


model Transaction {
  id            Int               @id @default(autoincrement())
  type          TransactionType
  category      String            // "Affitto", "Materiali", "Acconto", ecc.
  description   String
  amount        Float
  date          DateTime          @default(now())
  attachmentUrl String?
  deletedAt     DateTime?         // soft delete come da regole globali utente
  createdAt     DateTime          @default(now())

  @@index([date, type])
  @@index([deletedAt])
  @@index([category])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model FormTemplate {
  id          Int       @id @default(autoincrement())
  name        String    // es. "Scheda Cliente Standard", "Consenso Tattoo"
  schemaB64   String    // struttura del form in Base64
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SpesaLibera {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WhatsAppTemplate {
  id          Int       @id @default(autoincrement())
  name        String    // es. "Conferma Appuntamento", "Reminder 24h"
  category    String?
  body        String    // testo con variabili {{nome}}, {{data}}, ecc.
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  logs        WhatsAppMessageLog[]

  @@index([category])
  @@index([isActive])
}

model WhatsAppMessageLog {
  id              Int                   @id @default(autoincrement())
  template        WhatsAppTemplate?     @relation(fields: [templateId], references: [id])
  templateId      Int?
  booking         Booking?              @relation(fields: [bookingId], references: [id])
  bookingId       Int?
  customer        Customer?             @relation(fields: [customerId], references: [id])
  customerId      Int?
  createdBy       User                  @relation(fields: [createdById], references: [id])
  createdById     Int
  recipientName   String?
  recipientPhone  String
  templateName    String?
  message         String
  status          WhatsAppMessageStatus @default(MANUAL_SENT)
  variablesJson   Json?
  createdAt       DateTime              @default(now())

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([templateId, createdAt])
  @@index([createdById])
}

enum WhatsAppMessageStatus {
  MANUAL_SENT
  FAILED
}

model Config {
  id        Int     @id @default(autoincrement())
  paramsKey String  @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paramsKey])
}

model Attachment {
  id        String   @id @default(cuid())
  bookingId Int
  fileName  String
  fileSize  Int
  mimeType  String
  filePath  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

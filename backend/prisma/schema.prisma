generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int         @id @default(autoincrement())
  name          String
  email         String      @unique
  password      String      // hashed password
  role          Role        @default(ARTIST)
  phone         String?
  color         String?     // colore calendario per il collaboratore
  deletedAt     DateTime?   // soft delete
  createdAt     DateTime    @default(now())
  whatsappLogs  WhatsAppMessageLog[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  ARTIST
}

enum BookingAction {
  CREATED
  UPDATED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum StaffType {
  COLLABORATORE
  APPRENDISTA
}

model Staff {
  id        Int       @id @default(autoincrement())
  name      String
  type      StaffType
  color     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings  Booking[]
  shifts    Shift[]
}

model Shift {
  id            String    @id @default(cuid())
  date          DateTime
  startTime     String
  endTime       String
  breakDuration Int?
  notes         String?
  staffId       Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staff         Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
}

model Customer {
  id            Int         @id @default(autoincrement())
  firstName     String
  lastName      String
  phone         String
  email         String?
  notes         String?
  deletedAt     DateTime?   // soft delete
  createdAt     DateTime    @default(now())
  bookings      Booking[]
  whatsappLogs  WhatsAppMessageLog[]

  @@index([deletedAt, createdAt])
}

model Booking {
  id              Int             @id @default(autoincrement())
  customer        Customer        @relation(fields: [customerId], references: [id])
  customerId      Int
  artist          Staff?          @relation(fields: [artistId], references: [id])
  artistId        Int?
  date            DateTime
  duration        Int             @default(120)  // durata in minuti
  status          BookingStatus   @default(CONFIRMED)
  price           Float?
  deposit         Float?
  notes           String?
  outlookEventId  String?         // riservato per futura integrazione Outlook
  formData        Json?           // dati dinamici da form in base64
  history         BookingHistory[]
  deletedAt       DateTime?       // soft delete
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  whatsappLogs    WhatsAppMessageLog[]

  @@index([customerId, deletedAt])
  @@index([artistId, date])
  @@index([artistId, status, date])
  @@index([status, date])
  @@index([date])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  RESCHEDULED
  COMPLETED
}

model BookingHistory {
  id          Int            @id @default(autoincrement())
  booking     Booking        @relation(fields: [bookingId], references: [id])
  bookingId   Int
  action      BookingAction
  oldDate     DateTime?
  newDate     DateTime?
  changedBy   String
  changedAt   DateTime       @default(now())
}


model Transaction {
  id            Int               @id @default(autoincrement())
  type          TransactionType
  category      String            // "Affitto", "Materiali", "Acconto", ecc.
  description   String
  amount        Float
  date          DateTime          @default(now())
  artistId      Int?              // @deprecated — non relazionato, mantenuto per retrocompatibilità
  attachmentUrl String?
  deletedAt     DateTime?         // soft delete come da regole globali utente
  createdAt     DateTime          @default(now())

  @@index([date, type])
  @@index([deletedAt])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model FormTemplate {
  id          Int       @id @default(autoincrement())
  name        String    // es. "Scheda Cliente Standard", "Consenso Tattoo"
  schemaB64   String    // struttura del form in Base64
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SpesaLibera {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WhatsAppTemplate {
  id          Int       @id @default(autoincrement())
  name        String    // es. "Conferma Appuntamento", "Reminder 24h"
  category    String?
  body        String    // testo con variabili {{nome}}, {{data}}, ecc.
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  logs        WhatsAppMessageLog[]
}

model WhatsAppMessageLog {
  id              Int                   @id @default(autoincrement())
  template        WhatsAppTemplate?     @relation(fields: [templateId], references: [id])
  templateId      Int?
  booking         Booking?              @relation(fields: [bookingId], references: [id])
  bookingId       Int?
  customer        Customer?             @relation(fields: [customerId], references: [id])
  customerId      Int?
  createdBy       User                  @relation(fields: [createdById], references: [id])
  createdById     Int
  recipientName   String?
  recipientPhone  String
  templateName    String?
  message         String
  status          WhatsAppMessageStatus @default(MANUAL_SENT)
  variablesJson   Json?
  createdAt       DateTime              @default(now())

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([templateId, createdAt])
}

enum WhatsAppMessageStatus {
  MANUAL_SENT
  FAILED
}

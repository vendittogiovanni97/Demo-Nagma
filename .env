# Variabili per docker-compose (npm run db:up) — file locale, NON committare.
# Deve coincidere con DATABASE_URL in backend/.env.
# NOTA: il volume Docker esistente è stato inizializzato con queste credenziali;
# per cambiarle occorre ricreare il volume (docker compose down -v) e re-seeddare.
POSTGRES_DB=nagmadb
POSTGRES_USER=root
POSTGRES_PASSWORD=root123
POSTGRES_PORT=5433

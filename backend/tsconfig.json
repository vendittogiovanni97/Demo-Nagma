{
  "ts-node": {
    "files": true
  },
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "..",
    "ignoreDeprecations": "5.0",
    "paths": {
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src/**/*", "../schemas/**/*"]
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    Int                  @id @default(autoincrement())
  name                  String
  // NESSUN @unique globale sull'email: usiamo un indice UNICO PARZIALE
  // (WHERE "deletedAt" IS NULL) creato via migration manuale, così un utente
  // soft-deleted non blocca la re-registrazione dell'email.
  // Il check applicativo (findFirst con deletedAt: null) garantisce l'unicità
  // tra gli utenti attivi. Vedi 20260828120000_partial_unique_user_email.
  email                 String
  password              String
  role                  Role                 @default(ADMIN)
  phone                 String?
  color                 String?
  theme                 ThemeMode            @default(SYSTEM)
  tokenVersion          Int                  @default(0)
  deletedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  bookingHistories      BookingHistory[]
  transactionHistories  TransactionHistory[]
  whatsappLogs          WhatsAppMessageLog[]
  preference            UserPreference?
  savedViews            SavedView[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

model Staff {
  id          Int         @id @default(autoincrement())
  name        String
  type        StaffType
  color       String
  isRentPayee Boolean     @default(false)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  bookings    Booking[]
  creamSales  CreamSale[]
  shifts      Shift[]

  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("staff")
}

model Shift {
  id            String   @id @default(cuid())
  date          DateTime
  startTime     String
  endTime       String
  breakDuration Int?
  notes         String?
  staffId       Int
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([staffId, date])
  @@index([deletedAt])
  @@map("shifts")
}

model Customer {
  id           Int                  @id @default(autoincrement())
  firstName    String
  lastName     String
  phone        String
  email        String?
  notes        String?
  deletedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  bookings     Booking[]
  whatsappLogs WhatsAppMessageLog[]

  @@index([phone])
  @@index([email])
  @@index([lastName, firstName])
  @@index([deletedAt, createdAt])
  @@map("customers")
}

model Booking {
  id             Int                  @id @default(autoincrement())
  customerId     Int
  artistId       Int?
  date           DateTime
  duration       Int                  @default(120)
  status         BookingStatus        @default(CREATO)
  price          Decimal?             @db.Decimal(10, 2)
  deposit        Decimal?             @db.Decimal(10, 2)
  notes          String?
  outlookEventId String?
  formData       Json?
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  attachments    Attachment[]
  artist         Staff?               @relation(fields: [artistId], references: [id], onDelete: SetNull)
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  history        BookingHistory[]
  whatsappLogs   WhatsAppMessageLog[]
  placement      BookingPlacement?

  @@index([customerId, deletedAt])
  @@index([artistId, date])
  @@index([artistId, status, date])
  @@index([status, date])
  @@index([status])
  @@index([date])
  @@index([deletedAt, date])
  @@index([deletedAt, status, date])
  @@map("bookings")
}

model CreamTattoo {
  id          Int         @id @default(autoincrement())
  name        String      @default("Crema Protettiva Tattoo")
  description String?
  isActive    Boolean     @default(true)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  sales       CreamSale[]

  @@index([deletedAt])
  @@map("cream_tattoos")
}

model CreamSale {
  id        Int         @id @default(autoincrement())
  creamId   Int
  artistId  Int
  quantity  Int         @default(1)
  soldAt    DateTime    @default(now())
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  artist    Staff       @relation(fields: [artistId], references: [id], onDelete: Restrict)
  cream     CreamTattoo @relation(fields: [creamId], references: [id], onDelete: Restrict)

  @@index([creamId, soldAt])
  @@index([artistId, soldAt])
  @@index([deletedAt])
  @@map("cream_sales")
}

model BookingHistory {
  id          Int           @id @default(autoincrement())
  bookingId   Int
  action      BookingStatus
  oldDate     DateTime?
  newDate     DateTime?
  changedById Int?
  changedAt   DateTime      @default(now())
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy   User?         @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([bookingId, changedAt])
  @@index([changedById])
  @@map("booking_histories")
}

model Transaction {
  id            Int                  @id @default(autoincrement())
  type          TransactionType
  category      String
  description   String
  amount        Decimal              @db.Decimal(10, 2)
  date          DateTime             @default(now())
  attachmentUrl String?
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sourceId      Int?
  sourceType    String?
  history       TransactionHistory[]

  @@index([date, type])
  @@index([deletedAt])
  @@index([deletedAt, date])
  @@index([category])
  @@index([sourceId, sourceType])
  @@map("transactions")
}

model TransactionHistory {
  id            Int             @id @default(autoincrement())
  transactionId Int
  action        String
  oldData       Json?
  newData       Json?
  changedById   Int?
  changedAt     DateTime        @default(now())
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  changedBy     User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([transactionId, changedAt])
  @@index([changedById])
  @@map("transaction_histories")
}

model FormTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  schemaB64 String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("form_templates")
}

model SpesaLibera {
  id        Int      @id @default(autoincrement())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([deletedAt])
  @@map("spese_libere")
}

model EntrataLibera {
  id        Int      @id @default(autoincrement())
  name      String
  amount    Decimal  @db.Decimal(10, 2)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([deletedAt])
  @@map("entrate_libere")
}

model WhatsAppTemplate {
  id        Int                  @id @default(autoincrement())
  name      String
  category  String?
  body      String
  isActive  Boolean              @default(true)
  deletedAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  logs      WhatsAppMessageLog[]

  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@map("whatsapp_templates")
}

model WhatsAppMessageLog {
  id             Int                   @id @default(autoincrement())
  templateId     Int?
  bookingId      Int?
  customerId     Int?
  createdById    Int
  recipientName  String?
  recipientPhone String
  templateName   String?
  message        String
  status         WhatsAppMessageStatus @default(MANUAL_SENT)
  variablesJson  Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  booking        Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy      User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  customer       Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  template       WhatsAppTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([templateId, createdAt])
  @@index([createdById])
  @@index([deletedAt])
  @@map("whatsapp_message_logs")
}

model Config {
  id        Int      @id @default(autoincrement())
  paramsKey String   @unique
  value     String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paramsKey])
  @@index([deletedAt])
  @@map("configs")
}

model ClientConfig {
  id                   Int           @id @default(autoincrement())
  clientName           String
  clientLogoUrl        String?
  clientTimeZone       String        @default("Europe/Rome")
  clientLocale         String        @default("it-IT")
  primaryColor         String        @default("#1976d2")
  secondaryColor       String        @default("#ff9800")
  features             Json
  maxUsers             Int           @default(50)
  maxBookings          Int           @default(10000)
  maxAttachmentSizeMB  Int           @default(50)
  apiRateLimitPerMinute Int          @default(100)
  bookingUpdatePassword String?
  customFields         Json?
  customFieldsRel      CustomField[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("client_configs")
}

model CustomField {
  id          String   @id @default(cuid())
  entityType  String   // "customer", "booking", "staff", etc.
  fieldName   String
  fieldType   String   // "string", "number", "boolean", "date", "select", "multiselect"
  fieldLabel  String
  isRequired  Boolean  @default(false)
  options     Json?    // per select/multiselect
  defaultValue Json?
  clientId    Int
  clientConfig ClientConfig @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, fieldName, clientId])
  @@index([clientId])
  @@index([entityType])
  @@index([deletedAt])
  @@map("custom_fields")
}

model Attachment {
  id        String   @id @default(cuid())
  bookingId Int
  fileName  String
  fileSize  Int
  mimeType  String
  filePath  String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([deletedAt])
  @@map("attachments")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  ARTIST
}

enum StaffType {
  COLLABORATORE
  APPRENDISTA
}

enum BookingStatus {
  CREATO
  CONFERMATO
  COMPLETATO
  MODIFICATO
  SPOSTATO
  ANNULLATO
  CANCELLATO
}

enum TransactionType {
  ENTRATA
  USCITA
}

enum WhatsAppMessageStatus {
  MANUAL_SENT
  FAILED
}

model BookingPlacement {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @unique
  bodyZone   String
  view       String?  @default("FRONT")
  x          Float?
  y          Float?
  sizeWidth  Float?
  sizeHeight Float?
  notes      String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([deletedAt])
  @@map("booking_placements")
}

model UserPreference {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  language           String   @default("it")
  timezone           String   @default("Europe/Rome")
  dateFormat         String   @default("DD/MM/YYYY")
  itemsPerPage       Int      @default(25)
  emailNotifications Boolean  @default(true)
  inAppNotifications Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model SavedView {
  id        Int      @id @default(autoincrement())
  userId    Int
  module    String
  name      String
  filters   Json
  columns   Json?
  sort      Json?
  isDefault Boolean  @default(false)
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, module])
  @@map("saved_views")
}

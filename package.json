{
  "name": "demo-nagma",
  "version": "2.0.19",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "start": "concurrently \"npm run start --prefix backend\" \"npm run start --prefix frontend\"",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "deploy": "./infrastructure/deploy/deploy.sh",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:migrate:prod": "npm run db:migrate:prod --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:seed:demo": "npm run db:seed:demo --prefix backend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "clean": "npm run clean:backend && npm run clean:frontend",
    "clean:backend": "rm -rf backend/dist",
    "clean:frontend": "rm -rf frontend/.next frontend/tsconfig.tsbuildinfo",
    "typecheck": "(cd backend && npx tsc --noEmit) && (cd frontend && npx tsc --noEmit)",
    "test": "npm test --prefix backend",
    "test:unit": "npm run test:unit --prefix backend",
    "test:integration": "npm run test:integration --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:api": "npm run test:api --prefix backend",
    "make:executable": "chmod +x starter.command aggiorna.command",
    "postinstall": "chmod +x starter.command aggiorna.command 2>/dev/null || true",
    "hooks:install": "sh scripts/hooks/install.sh",
    "db:repair:password": "npm run db:repair:password --prefix backend",
    "db:seed:finance": "npm run db:seed:finance --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  password      String      // hashed password
  role          Role        @default(ARTIST)
  phone         String?
  color         String?     // colore calendario per il collaboratore
  deletedAt     DateTime?   // soft delete
  createdAt     DateTime    @default(now())
  bookings      Booking[]
  shifts        Shift[]
  whatsappLogs  WhatsAppMessageLog[]
}

enum Role {
  ADMIN
  USER
  ARTIST
}

model Customer {
  id            String      @id @default(cuid())
  firstName     String
  lastName      String
  phone         String
  email         String?
  notes         String?
  deletedAt     DateTime?   // soft delete
  createdAt     DateTime    @default(now())
  bookings      Booking[]
  whatsappLogs  WhatsAppMessageLog[]
}

model Booking {
  id              String          @id @default(cuid())
  customer        Customer        @relation(fields: [customerId], references: [id])
  customerId      String
  artist          User            @relation(fields: [artistId], references: [id])
  artistId        String
  date            DateTime
  status          BookingStatus   @default(CONFIRMED)
  price           Float?
  deposit         Float?
  notes           String?
  outlookEventId  String?         // ID evento su Outlook per sincronizzazione
  formData        Json?           // dati dinamici da form in base64
  history         BookingHistory[]
  deletedAt       DateTime?       // soft delete
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  whatsappLogs    WhatsAppMessageLog[]
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  RESCHEDULED
  COMPLETED
}

model BookingHistory {
  id          String    @id @default(cuid())
  booking     Booking   @relation(fields: [bookingId], references: [id])
  bookingId   String
  action      String    // "CREATED", "RESCHEDULED", "CANCELLED"
  oldDate     DateTime?
  newDate     DateTime?
  changedBy   String
  changedAt   DateTime  @default(now())
}

model Shift {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  weekStart DateTime  // lunedì della settimana
  dayOfWeek Int       // 0=Lun, 1=Mar, ... 6=Dom
  startTime String    // "09:00"
  endTime   String    // "18:00"
  isOff     Boolean   @default(false)
  notes     String?
  deletedAt DateTime? // soft delete
}

model Transaction {
  id            String            @id @default(cuid())
  type          TransactionType
  category      String            // "Affitto", "Materiali", "Acconto", ecc.
  description   String
  amount        Float
  date          DateTime          @default(now())
  artistId      String?
  attachmentUrl String?
  deletedAt     DateTime?         // soft delete come da regole globali utente
  createdAt     DateTime          @default(now())
}

enum TransactionType {
  INCOME
  EXPENSE
}

model FormTemplate {
  id          String    @id @default(cuid())
  name        String    // es. "Scheda Cliente Standard", "Consenso Tattoo"
  schemaB64   String    // struttura del form in Base64
  createdAt   DateTime  @default(now())
}

model WhatsAppTemplate {
  id          String    @id @default(cuid())
  name        String    // es. "Conferma Appuntamento", "Reminder 24h"
  category    String?
  body        String    // testo con variabili {{nome}}, {{data}}, ecc.
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  logs        WhatsAppMessageLog[]
}

model WhatsAppMessageLog {
  id              String                @id @default(cuid())
  template        WhatsAppTemplate?     @relation(fields: [templateId], references: [id])
  templateId      String?
  booking         Booking?              @relation(fields: [bookingId], references: [id])
  bookingId       String?
  customer        Customer?             @relation(fields: [customerId], references: [id])
  customerId      String?
  createdBy       User                  @relation(fields: [createdById], references: [id])
  createdById     String
  recipientName   String?
  recipientPhone  String
  templateName    String?
  message         String
  status          WhatsAppMessageStatus @default(MANUAL_SENT)
  variablesJson   Json?
  createdAt       DateTime              @default(now())
}

enum WhatsAppMessageStatus {
  MANUAL_SENT
  FAILED
}

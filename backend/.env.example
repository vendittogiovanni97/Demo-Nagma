# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nagmadb?schema=public

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_QUESTO_CON_UN_SEGRETO_LUNGO_E_CASUALE
JWT_EXPIRY=7d

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL del frontend (senza slash finale)
CORS_ORIGINS=http://localhost:3000

# ─── RATE LIMIT ──────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8

# ─── SICUREZZA PRENOTAZIONI ──────────────────────────────────────────────────
# Password richiesta per modificare una prenotazione esistente
BOOKING_UPDATE_PASSWORD=cambia_questa_password

# ─── OPZIONALI ───────────────────────────────────────────────────────────────
DEBUG_HTTP=false

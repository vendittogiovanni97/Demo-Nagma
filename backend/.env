DATABASE_URL=postgresql://postgres:root123@localhost:5432/nagmadb?schema=public
JWT_SECRET=a3f8c2d7e1b94056f2a8c3d6e0b7f1a4c9d2e5f8b1a3c6d9e2f5a8b4c7d0e3f6
JWT_EXPIRY=7d
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
DEBUG_HTTP=true
LOG_LEVEL=INFO
# Configurazioni di sistema (lasciare sempre a true per caricare impostazioni dal DB)
INIT_CONFIG_FROM_DB=true
INIT_CONFIG_SEED=true
SEED_PROFILE=nagma


# Backup PostgreSQL (Nativo / Senza Docker)
DB_BACKUP_ENABLED=true
DB_BACKUP_PATH=./backups/database
DB_BACKUP_DELAY_MINUTES=10
DB_BACKUP_RETENTION=7
DB_BACKUP_PG_DUMP_PATH=pg_dump
# Opzionale: Usato solo se PostgreSQL gira in un container Docker
# DB_BACKUP_DOCKER_CONTAINER=nagma-postgres

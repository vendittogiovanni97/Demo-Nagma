#!/bin/sh
#
# Controlli eseguiti prima di ogni push. Se falliscono, il push non parte.
# Installazione: npm run hooks:install
# Scavalco consapevole in emergenza: git push --no-verify
#

# Git LFS: comportamento preesistente, va mantenuto.
if command -v git-lfs >/dev/null 2>&1; then
  git lfs pre-push "$@" || exit $?
fi

# Gli hook girano con un ambiente minimo: recuperiamo node/npm come fanno gli .command
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
[ -f "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 1

fallito() {
  printf '\n\033[31m✗ %s\033[0m\n' "$1"
  printf '\n\033[31mPush annullato.\033[0m Correggi prima di spedire.\n'
  printf 'Se è un\''emergenza e sai cosa stai facendo: \033[1mgit push --no-verify\033[0m\n\n'
  exit 1
}

printf '\n\033[1m🔍 Controlli prima del push...\033[0m\n\n'

printf '  lint ... '
npm run lint --prefix backend >/tmp/nagma-push.log 2>&1 || { printf '\n'; tail -20 /tmp/nagma-push.log; fallito "lint backend"; }
npm run lint --prefix frontend >/tmp/nagma-push.log 2>&1 || { printf '\n'; tail -20 /tmp/nagma-push.log; fallito "lint frontend"; }
printf '\033[32mok\033[0m\n'

printf '  typecheck ... '
npm run typecheck >/tmp/nagma-push.log 2>&1 || { printf '\n'; tail -25 /tmp/nagma-push.log; fallito "typecheck"; }
printf '\033[32mok\033[0m\n'

printf '  test unitari ... '
UNIT=$(cd backend && npx jest --selectProjects unit --runInBand --forceExit 2>&1)
echo "$UNIT" | grep -q "^Tests:.*failed" && { printf '\n'; echo "$UNIT" | grep -A12 "●.*›" | head -30; fallito "test unitari"; }
printf '\033[32m%s\033[0m\n' "$(echo "$UNIT" | grep '^Tests:' | sed 's/Tests: *//')"

# I test di integrazione sono gli unici che toccano il database vero:
# sono loro ad aver individuato il difetto sul salvataggio prenotazioni.
DB_URL=$(grep -E '^DATABASE_URL=' backend/.env 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"')
[ -z "$DB_URL" ] && fallito "DATABASE_URL non trovata in backend/.env"

DB_HOST=$(node -e "console.log(new URL(process.argv[1]).hostname)" "$DB_URL" 2>/dev/null)
DB_PORT=$(node -e "const u=new URL(process.argv[1]);console.log(u.port||5432)" "$DB_URL" 2>/dev/null)

if ! nc -z "$DB_HOST" "$DB_PORT" >/dev/null 2>&1; then
  printf '\n\033[33m⚠️  Database non raggiungibile su %s:%s\033[0m\n' "$DB_HOST" "$DB_PORT"
  printf '   I test di integrazione non possono girare, e sono quelli che\n'
  printf '   intercettano gli errori di salvataggio.\n\n'
  printf '   Avvia il database, oppure: \033[1mgit push --no-verify\033[0m\n\n'
  exit 1
fi

# Database separato: i test scrivono record e non devono sporcare i dati di lavoro.
TEST_URL=$(node -e "const u=new URL(process.argv[1]);u.pathname=u.pathname.replace(/\/*$/,'')+'_test';console.log(u.toString())" "$DB_URL")

printf '  preparazione database di test ... '
(cd backend && DATABASE_URL="$TEST_URL" npx prisma migrate deploy >/tmp/nagma-push.log 2>&1) || { printf '\n'; tail -15 /tmp/nagma-push.log; fallito "migrazioni sul database di test"; }
(cd backend && DATABASE_URL="$TEST_URL" npx tsx prisma/seed.ts >/tmp/nagma-push.log 2>&1) || { printf '\n'; tail -15 /tmp/nagma-push.log; fallito "seed del database di test"; }
printf '\033[32mok\033[0m\n'

printf '  test integrazione ... '
INT=$(cd backend && DATABASE_URL="$TEST_URL" npx jest --selectProjects integration --runInBand --forceExit 2>&1)
echo "$INT" | grep -q "^Tests:.*failed" && { printf '\n'; echo "$INT" | grep -A12 "●.*›" | head -30; fallito "test di integrazione"; }
printf '\033[32m%s\033[0m\n' "$(echo "$INT" | grep '^Tests:' | sed 's/Tests: *//')"

printf '\n\033[32m✓ Tutto verde.\033[0m 🚀 Push in corso...\n\n'
exit 0

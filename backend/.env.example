# SECURITY (Audit H4): impostare credenziali robuste. Devono coincidere con
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_PORT nel .env alla radice del repo
# (usato da docker-compose per il container PostgreSQL).
DATABASE_URL=postgresql://nagma:cambia-questa-password@localhost:5433/nagmadb?schema=public
JWT_SECRET=a3f8c2d7e1b94056f2a8c3d6e0b7f1a4c9d2e5f8b1a3c6d9e2f5a8b4c7d0e3f6
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
DEBUG_HTTP=true
LOG_LEVEL=INFO

# Rate limiting login (Audit H3)
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS: tentativi falliti per-account (email) nella finestra
# LOGIN_IP_RATE_LIMIT_MAX_ATTEMPTS: tentativi falliti per-IP (anti email-rotation)
# LOGIN_RATE_LIMIT_WINDOW_MINUTES: finestra in minuti per entrambi i limiti
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_IP_RATE_LIMIT_MAX_ATTEMPTS=20
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Backup PostgreSQL (Nativo / Senza Docker)
DB_BACKUP_ENABLED=true
DB_BACKUP_PATH=./backups/database
DB_BACKUP_DELAY_MINUTES=10
DB_BACKUP_RETENTION=7
DB_BACKUP_PG_DUMP_PATH=pg_dump
# Opzionale: Usato solo se PostgreSQL gira in un container Docker
# DB_BACKUP_DOCKER_CONTAINER=nagma-postgres

# Configurazioni di sistema
INIT_CONFIG_FROM_DB=true
INIT_CONFIG_SEED=true
SEED_PROFILE=nagma

# Error tracking (opzionale) — se impostato attiva Sentry (richiede: npm i @sentry/node)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# API docs in produzione (default: Swagger disabilitato se NODE_ENV=production)
# ENABLE_API_DOCS=false
BACKUP_EMAIL_ALL_AVVIO=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=backup@nagma.studio
SMTP_PASS=tuapasswordsmtp
MAIL_FROM="Nagma Backup" <backup@nagma.studio>
MAIL_TO=admin@nagma.studio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                  @id @default(autoincrement())
  name             String
  email            String               @unique
  password         String
  role             Role                 @default(ADMIN)
  phone            String?
  color            String?
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  bookingHistories BookingHistory[]
  transactionHistories TransactionHistory[]
  whatsappLogs     WhatsAppMessageLog[]

  @@index([role])
  @@index([deletedAt])
}

model Staff {
  id         Int         @id @default(autoincrement())
  name       String
  type       StaffType
  color      String
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  bookings   Booking[]
  creamSales CreamSale[]
  shifts     Shift[]

  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
}

model Shift {
  id            String   @id @default(cuid())
  date          DateTime
  startTime     String
  endTime       String
  breakDuration Int?
  notes         String?
  staffId       Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([staffId, date])
}

model Customer {
  id           Int                  @id @default(autoincrement())
  firstName    String
  lastName     String
  phone        String
  email        String?
  notes        String?
  deletedAt    DateTime?
  createdAt    DateTime             @default(now())
  bookings     Booking[]
  whatsappLogs WhatsAppMessageLog[]

  @@index([phone])
  @@index([email])
  @@index([lastName, firstName])
  @@index([deletedAt, createdAt])
}

model Booking {
  id             Int                  @id @default(autoincrement())
  customerId     Int
  artistId       Int?
  date           DateTime
  duration       Int                  @default(120)
  status         BookingStatus        @default(CREATO)
  price          Decimal?             @db.Decimal(10, 2)
  deposit        Decimal?             @db.Decimal(10, 2)
  notes          String?
  outlookEventId String?
  formData       Json?
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  attachments    Attachment[]
  artist         Staff?               @relation(fields: [artistId], references: [id])
  customer       Customer             @relation(fields: [customerId], references: [id])
  history        BookingHistory[]
  whatsappLogs   WhatsAppMessageLog[]

  @@index([customerId, deletedAt])
  @@index([artistId, date])
  @@index([artistId, status, date])
  @@index([status, date])
  @@index([status])
  @@index([date])
}

model CreamTattoo {
  id          Int         @id @default(autoincrement())
  name        String      @default("Crema Protettiva Tattoo")
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  sales       CreamSale[]
}

model CreamSale {
  id       Int         @id @default(autoincrement())
  creamId  Int
  artistId Int
  quantity Int         @default(1)
  soldAt   DateTime    @default(now())
  artist   Staff       @relation(fields: [artistId], references: [id])
  cream    CreamTattoo @relation(fields: [creamId], references: [id])

  @@index([creamId, soldAt])
  @@index([artistId, soldAt])
}

model BookingHistory {
  id          Int           @id @default(autoincrement())
  bookingId   Int
  action      BookingStatus
  oldDate     DateTime?
  newDate     DateTime?
  changedById Int?
  changedAt   DateTime      @default(now())
  booking     Booking       @relation(fields: [bookingId], references: [id])
  changedBy   User?         @relation(fields: [changedById], references: [id])

  @@index([bookingId, changedAt])
  @@index([changedById])
}

model Transaction {
  id            Int                  @id @default(autoincrement())
  type          TransactionType
  category      String
  description   String
  amount        Decimal              @db.Decimal(10, 2)
  date          DateTime             @default(now())
  attachmentUrl String?
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  sourceId      Int?
  sourceType    String?              // BOOKING, SPESA_LIBERA, ARTIST_PAYMENT
  history       TransactionHistory[]

  @@index([date, type])
  @@index([deletedAt])
  @@index([category])
  @@index([sourceId, sourceType])
}

model TransactionHistory {
  id            Int             @id @default(autoincrement())
  transactionId Int
  action        String          // CREATED, UPDATED, DELETED
  oldData       Json?
  newData       Json?
  changedById   Int?
  changedAt     DateTime        @default(now())
  transaction   Transaction     @relation(fields: [transactionId], references: [id])
  changedBy     User?           @relation(fields: [changedById], references: [id])

  @@index([transactionId, changedAt])
  @@index([changedById])
}

model FormTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  schemaB64 String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpesaLibera {
  id        Int      @id @default(autoincrement())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WhatsAppTemplate {
  id        Int                  @id @default(autoincrement())
  name      String
  category  String?
  body      String
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  logs      WhatsAppMessageLog[]

  @@index([category])
  @@index([isActive])
}

model WhatsAppMessageLog {
  id             Int                   @id @default(autoincrement())
  templateId     Int?
  bookingId      Int?
  customerId     Int?
  createdById    Int
  recipientName  String?
  recipientPhone String
  templateName   String?
  message        String
  status         WhatsAppMessageStatus @default(MANUAL_SENT)
  variablesJson  Json?
  createdAt      DateTime              @default(now())
  booking        Booking?              @relation(fields: [bookingId], references: [id])
  createdBy      User                  @relation(fields: [createdById], references: [id])
  customer       Customer?             @relation(fields: [customerId], references: [id])
  template       WhatsAppTemplate?     @relation(fields: [templateId], references: [id])

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([templateId, createdAt])
  @@index([createdById])
}

model Config {
  id        Int      @id @default(autoincrement())
  paramsKey String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paramsKey])
}

model Attachment {
  id        String   @id @default(cuid())
  bookingId Int
  fileName  String
  fileSize  Int
  mimeType  String
  filePath  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  ARTIST
}

enum StaffType {
  COLLABORATORE
  APPRENDISTA
}

enum BookingStatus {
  CREATO
  CONFERMATO
  COMPLETATO
  MODIFICATO
  SPOSTATO
  ANNULLATO
  CANCELLATO
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum WhatsAppMessageStatus {
  MANUAL_SENT
  FAILED
}
